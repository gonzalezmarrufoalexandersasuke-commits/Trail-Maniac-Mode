-- STREAMING_CHUNK:Configuring anti-simultaneous spawn protection system...
local lastSpawnTick = 0
local function safeSpawn(loadstringFunc)
task.spawn(function()
-- Ensures entities do not spawn all at once ("de jalón") by enforcing a cooldown between spawns
while tick() - lastSpawnTick < 20 do
task.wait(2)
end
lastSpawnTick = tick()
loadstringFunc()
end)
end
